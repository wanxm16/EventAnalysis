# AI服务配置文件示例
# 复制此文件为 ai_config.env 并填入您的配置信息

# =============================================================================
# AI服务提供商配置
# =============================================================================

# AI服务提供商选择 (openai/deepseek/qwen/zhipu/custom)
AI_PROVIDER=openai

# 通用API密钥（所有提供商通用）
AI_API_KEY=your_api_key_here

# =============================================================================
# 特定提供商API密钥（可选，如果设置了AI_API_KEY则无需配置）
# =============================================================================

# OpenAI API密钥
# OPENAI_API_KEY=sk-your_openai_api_key

# DeepSeek API密钥  
# DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# 阿里云通义千问API密钥
# QWEN_API_KEY=sk-your_qwen_api_key

# 智谱AI API密钥
# ZHIPU_API_KEY=your_zhipu_api_key

# 自定义API密钥
# CUSTOM_API_KEY=your_custom_api_key

# =============================================================================
# API服务配置
# =============================================================================

# 自定义API基础URL（可选，默认使用提供商官方URL）
# AI_BASE_URL=https://api.openai.com/v1

# 使用的模型名称（可选，默认使用提供商推荐模型）
# AI_MODEL=gpt-3.5-turbo

# 最大token数量
AI_MAX_TOKENS=1000

# 温度参数（0-1之间，越高越随机）
AI_TEMPERATURE=0.7

# 请求超时时间（秒）
AI_TIMEOUT=30

# =============================================================================
# 生产环境配置示例
# =============================================================================

# 示例1: 使用OpenAI官方服务
# AI_PROVIDER=openai
# AI_API_KEY=sk-your_openai_key
# AI_MODEL=gpt-3.5-turbo

# 示例2: 使用DeepSeek服务  
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-your_deepseek_key
# AI_MODEL=deepseek-chat

# 示例3: 使用阿里云通义千问
# AI_PROVIDER=qwen
# AI_API_KEY=sk-your_qwen_key
# AI_MODEL=qwen-turbo

# 示例4: 使用自定义API服务
# AI_PROVIDER=custom
# AI_API_KEY=your_custom_key
# AI_BASE_URL=https://your-custom-api.com/v1
# AI_MODEL=your-custom-model

# =============================================================================
# 开发环境配置说明
# =============================================================================

# 1. 复制此文件为 ai_config.env
# 2. 根据您的AI服务选择相应的配置
# 3. 填入正确的API密钥
# 4. 启动系统时配置会自动加载

# 注意：
# - 请勿将包含真实API密钥的配置文件提交到版本控制系统
# - ai_config.env 文件已添加到 .gitignore 中
# - 生产环境建议使用环境变量而非配置文件