# 海曙区事件分析系统配置文件模板
# 复制此文件为 config.env 并根据需要修改配置
# cp config.env.example config.env

# 服务端口配置
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 服务模式配置  
# DEV_MODE=false        # 开发模式，显示详细日志
# PROD_MODE=false       # 生产模式，简化输出

# 安装配置
# SKIP_INSTALL=false    # 跳过依赖安装检查

# 包管理器偏好 (pnpm|yarn|npm)
# PREFERRED_PKG_MANAGER=pnpm

# 健康检查配置
HEALTH_CHECK_TIMEOUT=30  # 健康检查超时时间(秒)
HEALTH_CHECK_INTERVAL=1  # 健康检查间隔时间(秒)

# 日志配置
ENABLE_DEBUG_LOG=false          # 启用调试日志
LOG_TO_FILE=false              # 日志写入文件
LOG_FILE_PATH="logs/system.log"  # 日志文件路径

# Python 虚拟环境路径（可选）
# PYTHON_VENV_PATH="backend/venv"

# React 构建配置
# REACT_APP_API_URL="http://localhost:8000"    # API服务地址
# REACT_APP_TITLE="海曙区事件分析系统"         # 应用标题

# ============================================================================= 
# AI服务配置 - 必需配置
# ============================================================================= 

# AI服务提供商选择 (openai/deepseek/qwen/zhipu/custom)
export AI_PROVIDER=deepseek

# AI API密钥（根据选择的提供商填入相应密钥）
export AI_API_KEY=sk-your-api-key-here

# 自定义AI模型（可选，留空使用默认模型）
# export AI_MODEL=deepseek-chat

# 自定义API地址（可选，留空使用官方地址）
# export AI_BASE_URL=https://api.deepseek.com

# AI参数配置（可选）
# export AI_MAX_TOKENS=1000
# export AI_TEMPERATURE=0.7
# export AI_TIMEOUT=30

# 兼容性配置：旧版本DeepSeek配置（建议使用上面的AI_API_KEY）
export DEEPSEEK_API_KEY=sk-your-api-key-here

# ============================================================================= 
# AI服务提供商配置说明
# ============================================================================= 

# 1. OpenAI 配置示例:
#    export AI_PROVIDER=openai
#    export AI_API_KEY=sk-your-openai-key
#    export AI_MODEL=gpt-3.5-turbo

# 2. DeepSeek 配置示例:
#    export AI_PROVIDER=deepseek  
#    export AI_API_KEY=sk-your-deepseek-key
#    export AI_MODEL=deepseek-chat

# 3. 阿里云通义千问配置示例:
#    export AI_PROVIDER=qwen
#    export AI_API_KEY=sk-your-qwen-key
#    export AI_MODEL=qwen-turbo

# 4. 自定义API服务配置示例:
#    export AI_PROVIDER=custom
#    export AI_API_KEY=your-custom-key
#    export AI_BASE_URL=https://your-api.com/v1
#    export AI_MODEL=your-model-name 