# 海曙区事件分析系统配置文件模板
# 复制此文件为 config.env 并根据需要修改配置
# cp config.env.example config.env

# 服务端口配置
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 服务模式配置  
# DEV_MODE=false        # 开发模式，显示详细日志
# PROD_MODE=false       # 生产模式，简化输出

# 安装配置
# SKIP_INSTALL=false    # 跳过依赖安装检查

# 包管理器偏好 (pnpm|yarn|npm)
# PREFERRED_PKG_MANAGER=pnpm

# 健康检查配置
HEALTH_CHECK_TIMEOUT=30  # 健康检查超时时间(秒)
HEALTH_CHECK_INTERVAL=1  # 健康检查间隔时间(秒)

# 日志配置
ENABLE_DEBUG_LOG=false          # 启用调试日志
LOG_TO_FILE=false              # 日志写入文件
LOG_FILE_PATH="logs/system.log"  # 日志文件路径

# Python 虚拟环境路径（可选）
# PYTHON_VENV_PATH="backend/venv"

# React 构建配置
# REACT_APP_API_URL="http://localhost:8000"    # API服务地址
# REACT_APP_TITLE="海曙区事件分析系统"         # 应用标题

# DeepSeek AI配置 - 必需配置
# 请从 https://platform.deepseek.com/ 获取API密钥
export DEEPSEEK_API_KEY=sk-your-api-key-here 